# ─────────────────────────────────────────────────────────────
# Algorixe Car Care — Environment Template
# Copy to project root as `.env` and fill in real values.
# NEVER commit the filled-in .env file.
# NOTE: Do NOT add inline comments after values — docker compose's env_file
#       can fold them into the value. Keep comments on their own lines.
# ─────────────────────────────────────────────────────────────

# --- App ---
APP_NAME="Algorixe Sales Assistant"
# ENVIRONMENT: development | staging | production
ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8000
# PUBLIC_BASE_URL must be reachable by Twilio over HTTPS in production.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Security / JWT ---
# SECRET_KEY: generate with `openssl rand -hex 32`
SECRET_KEY=replace-with-64-char-random-hex-value-before-production-use-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Database ---
POSTGRES_USER=algorixe
POSTGRES_PASSWORD=algorixe_secret
POSTGRES_DB=algorixe
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://algorixe:algorixe_secret@db:5432/algorixe

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_CALLER_ID: your purchased Twilio number in E.164 format
TWILIO_CALLER_ID=+15551234567
# TWILIO_VOICE: Amazon Polly neural voice name
TWILIO_VOICE=Polly.Joanna-Neural
TWILIO_REGION=us1

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_FAST_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.6

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
