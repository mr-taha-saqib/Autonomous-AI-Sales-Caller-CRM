# ─────────────────────────────────────────────────────────────
# Values n8n needs (store as n8n Credentials, NOT in node fields).
# This file is a checklist, not loaded by n8n directly.
# ─────────────────────────────────────────────────────────────

# --- Public URL of your n8n instance (Twilio must reach it over HTTPS) ---
N8N_PUBLIC_URL=https://your-n8n-instance.example.com

# --- PostgreSQL (import schema.sql here) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=algorixe
PGUSER=algorixe
PGPASSWORD=change_me

# --- Twilio (Credential type: HTTP Basic Auth, or n8n Twilio node) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLER_ID=+15551234567          # your purchased Twilio number (E.164)
TWILIO_VOICE=Polly.Joanna-Neural       # TTS voice used in <Say>

# --- Anthropic / Claude (Credential type: HTTP Header Auth) ---
# Header 1:  x-api-key: <ANTHROPIC_API_KEY>
# Header 2:  anthropic-version: 2023-06-01
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8           # live conversation turns
CLAUDE_FAST_MODEL=claude-sonnet-4-6    # extraction / summarisation

# --- Optional integrations ---
# GOOGLE_CALENDAR_*  (n8n Google Calendar credential) for appointment events
# GMAIL_* / SMS      for confirmations
